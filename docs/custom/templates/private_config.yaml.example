# Template for the pysystemtrade private config — KEEP THE REAL FILE OUTSIDE THIS REPO.
#
# Setup (WARNING: the directory path must contain NO DOTS — pysystemtrade's
# resolve_path_and_filename_for_package treats dots as path separators, so
# ~/.config/... silently becomes ~/config/... and the config is not found):
#   mkdir -p ~/pysystemtrade-private
#   cp docs/custom/templates/private_config.yaml.example ~/pysystemtrade-private/private_config.yaml
#   echo 'export PYSYS_PRIVATE_CONFIG_DIR="$HOME/pysystemtrade-private"' >> ~/.bashrc
#   # then fill in broker_account below and create the data directories
#
# Verify with: .venv/bin/python scripts/ib/smoke_test_ib_connection.py --pst

# --- Interactive Brokers (paper) ---
broker_account: DUR207416        # paper account id from Client Portal (live ids start with U)
ib_ipaddress: 127.0.0.1
ib_port: 4002                    # paper gateway; live gateway is 4001
ib_idoffset: 100

# --- Data layer ---
mongo_host: 127.0.0.1
mongo_db: production_paper       # keep paper namespace separate from any future live db
parquet_store: /home/jungdaesuh/data/pysystemtrade/parquet
csv_backup_directory: /home/jungdaesuh/data/pysystemtrade/backups_csv

# --- Optional, set when needed (see docs/production.md) ---
# email_address: ...
# email_pwd: ...
# email_server: ...
# offsystem_backup_directory: ...
